<Window x:Class="ExamDictionary.WordDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExamDictionary"
        mc:Ignorable="d"
        Title="" Height="250" Width="800">
    <Window.Background>
        <ImageBrush ImageSource="/maxresdefault.jpg"/>
    </Window.Background>

    <Grid>
        <TextBlock x:Name="TEXT_BLOCK" Margin="0,10,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" FontSize="15" Background="Black" Foreground="White"/>
        <Button x:Name="Confirm" Content="✅" HorizontalAlignment="Left" Margin="715,164,0,0" VerticalAlignment="Top" Height="25" Width="30" FontSize="15" Click="Confirm_Click"/>
        <TextBox x:Name="Word" HorizontalAlignment="Left" Margin="40,84,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="150"/>
        <TextBox x:Name="Translate" HorizontalAlignment="Left" Margin="240,84,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="450"/>
        <TextBlock x:Name="arrows" Margin="205,72,0,0" HorizontalAlignment="Left" TextWrapping="Wrap" Text="⇔" VerticalAlignment="Top" FontSize="28"/>
    </Grid>

</Window>
