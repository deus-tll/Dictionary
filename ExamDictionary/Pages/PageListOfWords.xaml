<Page x:Class="ExamDictionary.Pages.PageListOfWords"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	  xmlns:local="clr-namespace:ExamDictionary.Pages"
	  mc:Ignorable="d" 
	  d:DesignHeight="450" d:DesignWidth="850"
	  Title="PageListOfWords" Loaded="Page_Loaded" Foreground="Black" >

    <Page.Background>
        <ImageBrush ImageSource="/vwkFVH.jpg"/>
    </Page.Background>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="61*"/>
            <ColumnDefinition Width="24*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=".3*"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>


        <DataGrid x:Name="wordsList" FontSize="14" FontWeight="Bold" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" HorizontalAlignment="Left" Grid.ColumnSpan="2">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Path = Word}" x:Name="HeaderOfWord" IsReadOnly="True" Width="300"/>
                <DataGridTextColumn Binding="{Binding Path = Translate}" x:Name="HeaderOfTranslations" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>


        <TextBlock TextWrapping="Wrap" Text="Відсортувати за:" Background="Black" Foreground="#FFE4E4E4" Width="100" FontSize="13.5" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,22,0,0" Grid.Column="1" Height="18"/>
        <Button x:Name="SortByWord" Content="↑↓" ToolTip="Відсортувати по слову в алфавітному порядку за зростанням/спаданням" Click="SortByWord_Click" Height="30" Width="35" FontSize="20" Margin="43,58,0,0" Grid.Column="1" Grid.Row="0" BorderBrush="Black" VerticalAlignment="Top" HorizontalAlignment="Left" BorderThickness="1,1,1,1"/>
        <Button x:Name="SortByDate" Content="&#x1F4C6;" ToolTip="Відсортувати по даті додавання слова в словник за зростанням/спаданням" Click="SortByDate_Click" Height="30" Width="35" FontSize="20" BorderBrush="Black" Grid.Column="1" Grid.Row="0" Margin="0,58,48,0" VerticalAlignment="Top" HorizontalAlignment="Right" BorderThickness="1,1,1,1"/>

        <TextBox x:Name="Word" IsEnabled="True" HorizontalAlignment="Left" Margin="10,60,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="150" Height="26" FontSize="14"/>
        <Button x:Name="AddWord" Content="➕" ToolTip="Додати слово"  HorizontalAlignment="Left" Margin="435,54,0,0" VerticalAlignment="Top" Width="40" Height="34" FontSize="18" BorderThickness="1,1,1,1" BorderBrush="Black" Click="AddWord_Click"/>
        <Button x:Name="ChangeWord" Content="✍" ToolTip="Редагувати слово" HorizontalAlignment="Left" VerticalAlignment="Top" Width="30" Height="26" FontSize="13" BorderThickness="1,1,1,1" BorderBrush="Black" Click="ChangeWord_Click" Margin="210,60,0,0"/>
        <Button x:Name="FindWord" Content="🔍" ToolTip="Знайти слово" HorizontalAlignment="Left" Margin="170,60,0,0" VerticalAlignment="Top" Width="30" Height="26" FontSize="13" Click="FindWord_Click"/>
        <Button x:Name="RemoveWord" Content="🗑" ToolTip="Видалити слово" HorizontalAlignment="Left" Margin="250,60,0,0" VerticalAlignment="Top" Width="30" Height="26" FontSize="13" Click="RemoveWord_Click"/>
        <Button x:Name="RefreshWordField" Content="&#8634;" ToolTip="Оновити" HorizontalAlignment="Left" Margin="290,60,0,0" VerticalAlignment="Top" Width="30" Height="26" FontSize="13" Click="RefreshWordField_Click"/>

    </Grid>
</Page>
