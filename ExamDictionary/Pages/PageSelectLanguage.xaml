<Page x:Class="ExamDictionary.Pages.PageSelectLanguage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	  xmlns:local="clr-namespace:ExamDictionary.Pages"
	  mc:Ignorable="d" 
	  d:DesignHeight="450" d:DesignWidth="850"
	  Title="PageSelectLanguage" Loaded="Page_Loaded">

    <Page.Background>
        <ImageBrush ImageSource="/vwkFVH.jpg"/>
    </Page.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".5*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width=".5*"/>
        </Grid.ColumnDefinitions>
        <Label Content="Виберіть дві мови для утворення або переходу до словника." HorizontalAlignment="Left" Margin="15,15,0,0" VerticalAlignment="Center" FontSize="24" Grid.ColumnSpan="2" Background="Black" Foreground="White"/>
        <ComboBox Name="FromLanguage" HorizontalAlignment="Left" Margin="50,30,0,0" Grid.Row="1" VerticalAlignment="Top" Width="180" Height="30" SelectionChanged="FromLanguage_SelectionChanged"/>
        <ComboBox Name="ToLanguage" HorizontalAlignment="Right" Margin="0,30,50,0" Grid.Row="1" VerticalAlignment="Top" Width="180" Height="30" ScrollViewer.CanContentScroll="True" SelectionChanged="ToLanguage_SelectionChanged"/>
        <TextBlock x:Name="arrows" Grid.Row="1" Margin="0,23,0,0" HorizontalAlignment="Center" TextWrapping="Wrap" Text="⇔" VerticalAlignment="Top" FontSize="28"/>
        <Button x:Name="Confirm" Content="Пуск" Grid.Column="1" HorizontalAlignment="Center" Margin="0,195,0,0"  Grid.Row="1" VerticalAlignment="Top" FontSize="13" Click="Confirm_Click" Height="30" Width="85" BorderThickness="5,5,5,5" BorderBrush="#FF2F1550" FontFamily="Segoe UI Black"></Button>

    </Grid>
</Page>
